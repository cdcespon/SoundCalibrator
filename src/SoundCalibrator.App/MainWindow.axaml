<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundCalibrator.App.Controls"
        x:Class="SoundCalibrator.App.MainWindow"
        Title="SoundCalibrator - Dual-Channel FFT Acoustic Measurement (Open Sound Meter Clone)"
        Width="1460" Height="820"
        Background="#0B0E14"
        FontFamily="Segoe UI">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Background="#141821" BorderBrush="#222836" BorderThickness="0,0,0,1" Padding="10,6">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- LOGO / TITULO -->
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="SOUND" Foreground="#00E5FF" FontWeight="Bold" FontSize="15" Margin="0,0,3,0"/>
                    <TextBlock Text="CALIBRATOR" Foreground="#E0E6ED" FontWeight="SemiBold" FontSize="15"/>
                </StackPanel>

                <!-- MODO DE MEDICION (TF vs RTA) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="Mode:" Foreground="#7E8B9B" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11"/>
                    <ComboBox x:Name="ModeCombo" Width="140" SelectedIndex="0">
                        <ComboBoxItem Content="Transfer Function"/>
                        <ComboBoxItem Content="RTA Spectrum"/>
                        <ComboBoxItem Content="Spectrogram"/>
                        <ComboBoxItem Content="Group Delay"/>
                    </ComboBox>
                </StackPanel>

                <!-- FUENTE DE AUDIO -->
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="Source:" Foreground="#7E8B9B" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11"/>
                    <ComboBox x:Name="SourceCombo" Width="170" SelectedIndex="0">
                        <ComboBoxItem Content="Pink Noise (Continuous)"/>
                        <ComboBoxItem Content="Sine 1kHz (Pure Tone)"/>
                        <ComboBoxItem Content="Sine Sweep (20Hz-20k)"/>
                        <ComboBoxItem Content="Gated Pink Noise (Burst)"/>
                        <ComboBoxItem Content="IEC 60268-1 Program Noise"/>
                        <ComboBoxItem Content="Polarity Pulse (Click)"/>
                        <ComboBoxItem Content="WASAPI Audio Device"/>
                    </ComboBox>
                </StackPanel>

                <!-- TAMAÑO DE FFT -->
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="FFT:" Foreground="#7E8B9B" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11"/>
                    <ComboBox x:Name="FftCombo" Width="75" SelectedIndex="1">
                        <ComboBoxItem Content="512"/>
                        <ComboBoxItem Content="1024"/>
                        <ComboBoxItem Content="2048"/>
                        <ComboBoxItem Content="4096"/>
                    </ComboBox>
                </StackPanel>

                <!-- VENTANA TEMPORAL -->
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="Win:" Foreground="#7E8B9B" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11"/>
                    <ComboBox x:Name="WindowCombo" Width="95" SelectedIndex="0">
                        <ComboBoxItem Content="Hann"/>
                        <ComboBoxItem Content="Blackman-H"/>
                        <ComboBoxItem Content="Rectangular"/>
                    </ComboBox>
                </StackPanel>

                <!-- PROMEDIO -->
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="Avg:" Foreground="#7E8B9B" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11"/>
                    <ComboBox x:Name="AveragingCombo" Width="95" SelectedIndex="1">
                        <ComboBoxItem Content="None"/>
                        <ComboBoxItem Content="Fast"/>
                        <ComboBoxItem Content="Slow"/>
                        <ComboBoxItem Content="Linear 16"/>
                        <ComboBoxItem Content="Infinite"/>
                    </ComboBox>
                </StackPanel>

                <!-- SUAVIZADO DE OCTAVA -->
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="Smooth:" Foreground="#7E8B9B" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11"/>
                    <ComboBox x:Name="SmoothingCombo" Width="85" SelectedIndex="0">
                        <ComboBoxItem Content="None (1)"/>
                        <ComboBoxItem Content="1/3 (2)"/>
                        <ComboBoxItem Content="1/6 (3)"/>
                        <ComboBoxItem Content="1/12 (4)"/>
                        <ComboBoxItem Content="1/24"/>
                    </ComboBox>
                </StackPanel>

                <!-- CURVA OBJETIVO (TARGET CURVE) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="Target:" Foreground="#7E8B9B" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11"/>
                    <ComboBox x:Name="TargetCombo" Width="95" SelectedIndex="0">
                        <ComboBoxItem Content="None"/>
                        <ComboBoxItem Content="Harman"/>
                        <ComboBoxItem Content="B&amp;K 1974"/>
                        <ComboBoxItem Content="Cinema X"/>
                        <ComboBoxItem Content="Flat (0dB)"/>
                    </ComboBox>
                </StackPanel>

                <!-- CURVA DELTA ERROR (MEAS - TARGET) -->
                <Button x:Name="DeltaBtn" Content="Δ DELTA (D)" Background="#263238" Foreground="#B0BEC5" FontWeight="Bold" Width="78" Margin="0,0,8,0" Padding="3,3" FontSize="10"/>

                <!-- INVERTIR POLARIDAD -->
                <Button x:Name="InvertPolarityBtn" Content="INV Ø (P)" Background="#263238" Foreground="#B0BEC5" FontWeight="Bold" Width="62" Margin="0,0,8,0" Padding="3,3" FontSize="10"/>

                <!-- COHERENCE BLANKING -->
                <StackPanel x:Name="BlankingPanel" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="Blank:" Foreground="#7E8B9B" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11"/>
                    <ComboBox x:Name="BlankingCombo" Width="70" SelectedIndex="0">
                        <ComboBoxItem Content="Off"/>
                        <ComboBoxItem Content="30%"/>
                        <ComboBoxItem Content="50%"/>
                        <ComboBoxItem Content="70%"/>
                    </ComboBox>
                </StackPanel>

                <!-- SIMULACION RETARDO -->
                <StackPanel x:Name="DelayPanel" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="Delay:" Foreground="#7E8B9B" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11"/>
                    <Slider x:Name="DelaySlider" Width="55" Minimum="0" Maximum="20" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="False"/>
                    <TextBlock x:Name="DelayText" Text="0.0 ms" Foreground="#FF9100" VerticalAlignment="Center" Width="38" Margin="2,0,0,0" FontSize="11"/>
                </StackPanel>

                <!-- AUTO DELAY TRACKER (IFFT) -->
                <Border x:Name="AutoDelayBorder" Background="#1A2230" CornerRadius="4" Padding="4,2" Margin="0,0,8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="IR:" Foreground="#7E8B9B" FontSize="10" VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <TextBlock x:Name="DetectedDelayText" Text="0.0 ms" Foreground="#00E676" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock x:Name="Rt60Text" Text="RT60: --" Foreground="#BA68C8" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,4,0" IsVisible="False"/>
                        <TextBlock x:Name="StiText" Text="STI: --" Foreground="#80D8FF" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,4,0" IsVisible="False"/>
                        <Button x:Name="AutoAlignBtn" Content="ALIGN (A)" Background="#E65100" Foreground="White" FontWeight="Bold" FontSize="9" Padding="4,2"/>
                    </StackPanel>
                </Border>

                <!-- CAPTURA Y GESTION DE TRAZAS -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="CaptureTraceBtn" Content="CAPTURE (C)" Background="#7B1FA2" Foreground="White" FontWeight="Bold" Width="82" Margin="0,0,3,0" Padding="3,3" FontSize="10"/>
                    <Button x:Name="ClearTracesBtn" Content="CLEAR" Background="#37474F" Foreground="#B0BEC5" Width="48" Margin="0,0,3,0" Padding="3,3" FontSize="10"/>
                    <Button x:Name="ExportTraceBtn" Content="EXPORT" Background="#00695C" Foreground="White" Width="52" Margin="0,0,3,0" Padding="3,3" FontSize="10"/>
                    <Button x:Name="ImportTraceBtn" Content="IMPORT" Background="#2E7D32" Foreground="White" Width="52" Margin="0,0,3,0" Padding="3,3" FontSize="10"/>
                    <Button x:Name="ToggleTracesPanelBtn" Content="PANEL (T)" Background="#4527A0" Foreground="White" Width="66" Margin="0,0,3,0" Padding="3,3" FontSize="10"/>
                    <Button x:Name="SnapshotBtn" Content="SNAP (S)" Background="#00838F" Foreground="White" Width="60" Margin="0,0,3,0" Padding="3,3" FontSize="10"/>
                    <Button x:Name="ReportBtn" Content="REPORT" Background="#283593" Foreground="White" Width="62" Margin="0,0,6,0" Padding="3,3" FontSize="10"/>
                    <Button x:Name="SuggestEqBtn" Content="PEQ (E)" Background="#00796B" Foreground="White" Width="55" Margin="0,0,6,0" Padding="3,3" FontSize="10"/>
                    <Button x:Name="CalibrateSplBtn" Content="CAL 94dB" Background="#33691E" Foreground="White" Width="62" Margin="0,0,6,0" Padding="3,3" FontSize="10"/>
                </StackPanel>

                <!-- BOTONES DE CONTROL -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartStopBtn" Content="PAUSE (Space)" Background="#1E88E5" Foreground="White" FontWeight="Bold" Width="88" Margin="0,0,3,0" FontSize="10"/>
                    <Button x:Name="ResetBtn" Content="RESET (R)" Background="#263238" Foreground="#E0E6ED" Width="64" FontSize="10"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- AREA CENTRAL: GRAFICO ACUSTICO + PANEL LATERAL DE TRAZAS -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <controls:AcousticGraphControl x:Name="GraphControl" Grid.Column="0"/>

            <!-- PANEL LATERAL GESTOR DE TRAZAS (COLLAPSIBLE) -->
            <Border x:Name="TraceManagerBorder" Grid.Column="1" Width="240" Background="#131720" BorderBrush="#1F2530" BorderThickness="1,0,0,0" IsVisible="True">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0" Background="#181D28" Padding="10,8" BorderBrush="#1F2530" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="STORED TRACES" Foreground="#E0E6ED" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            <Button x:Name="SpatialAvgBtn" Grid.Column="1" Content="AVG MICS" Background="#0277BD" Foreground="White" FontWeight="Bold" FontSize="9" Padding="4,2" Margin="0,0,4,0"/>
                            <Button x:Name="CloseTracePanelBtn" Grid.Column="2" Content="✕" Background="Transparent" Foreground="#7E8B9B" Padding="4,1" FontSize="11"/>
                        </Grid>
                    </Border>

                    <!-- LISTA SCROLLEABLE DE TRAZAS -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TraceListStack" Margin="8,8,8,8"/>
                    </ScrollViewer>

                    <!-- ALINEACION DE SUB+MAIN CROSSOVER -->
                    <Border Grid.Row="2" Background="#161B24" Padding="8" BorderBrush="#1F2530" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="CROSSOVER ALIGNMENT" Foreground="#00E5FF" FontWeight="Bold" FontSize="10" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Fc:" Foreground="#7E8B9B" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="CrossoverFreqCombo" Width="75" SelectedIndex="1" FontSize="10">
                                    <ComboBoxItem Content="60 Hz"/>
                                    <ComboBoxItem Content="80 Hz"/>
                                    <ComboBoxItem Content="100 Hz"/>
                                    <ComboBoxItem Content="120 Hz"/>
                                </ComboBox>
                                <Button x:Name="CalculateAlignmentBtn" Content="CALC" Background="#00838F" Foreground="White" FontWeight="Bold" FontSize="9" Padding="6,2" Margin="4,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="AlignmentResultText" Text="Capture ≥2 traces (Sub, Main)" Foreground="#556677" FontSize="9" TextWrapping="Wrap"/>
                            <Button x:Name="ApplyAlignmentBtn" Content="APPLY CORRECTION TO SUB" Background="#2E7D32" Foreground="White" FontWeight="Bold" FontSize="9" Padding="4,2" Margin="0,4,0,0" IsVisible="False" HorizontalAlignment="Stretch"/>
                            <!-- MULTI-ZONE DELAY MATRIX -->
                            <Border Height="1" Background="#1F2530" Margin="0,6,0,6"/>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                <TextBlock Text="DELAY MATRIX (ZONES)" Foreground="#FFB300" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                <Button x:Name="CalculateDelayMatrixBtn" Grid.Column="1" Content="CALC" Background="#E65100" Foreground="White" FontWeight="Bold" FontSize="9" Padding="6,2"/>
                            </Grid>
                            <TextBlock x:Name="DelayMatrixResultText" Text="Capture >=2 traces to calculate multi-zone relative delays" Foreground="#556677" FontSize="9" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- BARRA DE ESTADO INFERIOR -->
        <Border Grid.Row="2" Background="#0E1117" BorderBrush="#1C222E" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="LEGEND:" Foreground="#506070" FontSize="11" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Border Background="#00E5FF" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Magnitude (dB)" Foreground="#00E5FF" FontSize="11" Margin="0,0,14,0"/>

                    <Border Background="#FF9100" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Phase (°)" Foreground="#FF9100" FontSize="11" Margin="0,0,14,0"/>

                    <Border Background="#00E676" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Coherence" Foreground="#00E676" FontSize="11" Margin="0,0,14,0"/>

                    <Border Background="#FFD600" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="RTA (dBFS)" Foreground="#FFD600" FontSize="11" Margin="0,0,14,0"/>

                    <TextBlock x:Name="TracesCountText" Text="Captured Traces: 0" Foreground="#BA68C8" FontSize="11" FontWeight="SemiBold" Margin="0,0,14,0"/>

                    <Border x:Name="ThdBadge" Background="#1B2636" CornerRadius="3" Padding="5,1" Margin="0,0,14,0" VerticalAlignment="Center" IsVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="THD: " Foreground="#8C9BAE" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ThdText" Text="N/A" Foreground="#FF5252" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SplBadge" Background="#14241B" CornerRadius="3" Padding="5,1" Margin="0,0,14,0" VerticalAlignment="Center" IsVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SPL: " Foreground="#81C784" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SplText" Text="-- dBA" Foreground="#00E676" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="FeedbackBadge" Background="#3D1212" CornerRadius="3" Padding="5,1" Margin="0,0,14,0" VerticalAlignment="Center" IsVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FEEDBACK: " Foreground="#FF8A80" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="FeedbackText" Text="-- Hz" Foreground="#FF1744" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Shortcuts: [Space] Pause | [C] Capture | [R] Reset | [A] Align | [M] Mode | [1-4] Smoothing" Foreground="#556677" FontSize="11"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock x:Name="StatusDeviceText" Text="Synthetic Generator (48 kHz, FFT: 1024)" Foreground="#8C9BAE" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock x:Name="StatusAvgText" Text="Averages: 0" Foreground="#00E676" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock Text="GPU: 60 FPS" Foreground="#00E5FF" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

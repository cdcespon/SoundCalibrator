<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SoundCalibrator.App.Controls"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="880"
        x:Class="SoundCalibrator.App.MainWindow"
        Title=""
        Icon="/Assets/icon.ico"
        Background="{DynamicResource AppWindowBg}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        CanResize="True"
        Width="1440" Height="880"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Hide Full Screen Button (the two diagonal arrows) in window titlebar -->
        <Style Selector="Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0"/>
            <Setter Property="MaxWidth" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Button#PART_PopoverFullScreenButton">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0"/>
            <Setter Property="MaxWidth" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector=":is(Window) Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0"/>
            <Setter Property="MaxWidth" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector=":is(Window) Button#PART_PopoverFullScreenButton">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0"/>
            <Setter Property="MaxWidth" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>

        <!-- Modern Tech Cyber-Acoustic Styling -->
        <Style Selector="Button.dock-pill">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.dock-pill:pointerover">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.dock-pill-active">
            <Setter Property="Background" Value="#00F0FF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.dock-pill-purple">
            <Setter Property="Background" Value="#A855F7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.dock-pill-red">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Dark / Light Adaptive ComboBoxes -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource AppCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <!-- Drawer Tab Headers -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="Background" Value="#0D00F0FF"/>
        </Style>

        <!-- Zoom overlay buttons -->
        <Style Selector="Button.zoom-btn">
            <Setter Property="Background" Value="{DynamicResource AppCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.zoom-btn:pointerover">
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="Background" Value="#1A00F0FF"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="48,Auto,*,32">

        <!-- ================================================================= -->
        <!-- ROW 0: TOP HEADER TELEMETRY                                       -->
        <!-- ================================================================= -->
        <Border Grid.Row="0" Background="{DynamicResource AppHeaderBg}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="18,0,150,0" PointerPressed="OnHeaderPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                <!-- Left: Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <Border Width="30" Height="30" CornerRadius="8" BoxShadow="0 0 16 0 #5900F0FF">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#00F0FF" Offset="0"/>
                                <GradientStop Color="#A855F7" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"
                              Fill="#000000" Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <TextBlock x:Name="BrandTitleText" Text="Sound Calibrator" Foreground="{DynamicResource AppTextPrimary}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Telemetry in 1 line -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" BoxShadow="0 0 8 0 #10B981" VerticalAlignment="Center"/>
                        <TextBlock Text="ENGINE:" Foreground="#94A3B8" FontSize="10" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center"/>
                        <Border Background="#0DFFFFFF" Padding="6,2" CornerRadius="4">
                            <TextBlock Text="LIVE 60 FPS" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="DEVICE:" Foreground="#94A3B8" FontSize="10" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center"/>
                        <Border Background="#0DFFFFFF" Padding="6,2" CornerRadius="4">
                            <TextBlock x:Name="StatusDeviceText" Text="WASAPI 48kHz / 32-bit" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="ROUTING:" Foreground="#94A3B8" FontSize="10" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center"/>
                        <Border Background="#0DFFFFFF" Padding="6,2" CornerRadius="4">
                            <TextBlock x:Name="StatusRoutingText" Text="REF: CH 1  |  MEAS: CH 2" Foreground="#00F0FF" FontWeight="Bold" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="SPL Leq:" Foreground="#94A3B8" FontSize="10" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center"/>
                        <Border x:Name="SplBadge" Background="#1A10B981" BorderBrush="#4D10B981" BorderThickness="1" CornerRadius="4" Padding="8,2">
                            <TextBlock x:Name="SplText" Text="88.4 dBA" Foreground="#10B981" FontWeight="Bold" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                        </Border>
                    </StackPanel>

                    <!-- Theme Toggle Switch -->
                    <Button x:Name="ThemeToggleBtn" Content="☀️ LIGHT" Classes="dock-pill"
                            Background="{DynamicResource AppBadgeBg}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                            Foreground="#00F0FF" FontWeight="Bold" FontSize="10" Padding="8,4"
                            Cursor="Hand"
                            ToolTip.Tip="Toggle Dark / Light Mode (T)"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 1: GLASS CONTROL DOCK (2-Tier Modular Ribbon)                 -->
        <!-- ================================================================= -->
        <Border Grid.Row="1" Background="{DynamicResource AppRibbonBg}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="14,6">
            <StackPanel Spacing="6">
                
                <!-- TIER 1: MODES, SIGNAL SOURCE, DSP RESOLUTION, TARGET & BLANKING -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                    
                    <!-- Group 1: Modes Segmented Pills -->
                    <Border Grid.Column="0" Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="ModeTfBtn" Content="TRANSFER FN" Classes="dock-pill-active"/>
                            <Button x:Name="ModeRtaBtn" Content="RTA 1/3 OCT" Classes="dock-pill"/>
                            <Button x:Name="ModeEtcBtn" Content="IMPULSE / ETC" Classes="dock-pill"/>
                            <Button x:Name="ModeSpecBtn" Content="SPECTROGRAM" Classes="dock-pill"/>
                        </StackPanel>
                    </Border>

                    <!-- Group 2: Signal Source & Routing -->
                    <Border Grid.Column="1" Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Source:" Foreground="#64748B" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ComboBox x:Name="SourceCombo" Width="145" SelectedIndex="0">
                                <ComboBoxItem Content="Pink Noise (Continuous)"/>
                                <ComboBoxItem Content="Sine 1kHz (Pure Tone)"/>
                                <ComboBoxItem Content="Sine Sweep (20Hz-20k)"/>
                                <ComboBoxItem Content="Gated Pink Noise (Burst)"/>
                                <ComboBoxItem Content="IEC 60268-1 Noise"/>
                                <ComboBoxItem Content="Polarity Pulse (Click)"/>
                                <ComboBoxItem Content="SMPTE IMD (60Hz + 7k)"/>
                                <ComboBoxItem Content="CCIF IMD (19k + 20k)"/>
                                <ComboBoxItem Content="WASAPI Audio Device"/>
                            </ComboBox>
                            <Button x:Name="SwapChannelsBtn" Content="CH 1:2" Classes="dock-pill" Foreground="#00F0FF" FontWeight="Bold" ToolTip.Tip="Swap Ref and Meas channels (1:2 / 2:1)"/>
                            <Button x:Name="GenOutputBtn" Content="DAC: OFF" Classes="dock-pill" ToolTip.Tip="Physical audio DAC streaming"/>
                        </StackPanel>
                    </Border>

                    <!-- Group 3: DSP Resolution (FFT, Window, Smoothing, Averaging) -->
                    <Border Grid.Column="2" Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="FFT:" Foreground="#64748B" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ComboBox x:Name="FftCombo" Width="72" SelectedIndex="1">
                                <ComboBoxItem Content="512"/>
                                <ComboBoxItem Content="1024"/>
                                <ComboBoxItem Content="2048"/>
                                <ComboBoxItem Content="4096"/>
                                <ComboBoxItem Content="16384"/>
                            </ComboBox>

                            <TextBlock Text="Win:" Foreground="#64748B" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ComboBox x:Name="WindowCombo" Width="82" SelectedIndex="0">
                                <ComboBoxItem Content="Hann"/>
                                <ComboBoxItem Content="Blackman-H"/>
                                <ComboBoxItem Content="Rectangular"/>
                            </ComboBox>

                            <TextBlock Text="Smooth:" Foreground="#64748B" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ComboBox x:Name="SmoothingCombo" Width="84" SelectedIndex="0">
                                <ComboBoxItem Content="None (1)"/>
                                <ComboBoxItem Content="1/3 (2)"/>
                                <ComboBoxItem Content="1/6 (3)"/>
                                <ComboBoxItem Content="1/12 (4)"/>
                                <ComboBoxItem Content="1/24"/>
                            </ComboBox>

                            <TextBlock Text="Avg:" Foreground="#64748B" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ComboBox x:Name="AveragingCombo" Width="82" SelectedIndex="1">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="Fast"/>
                                <ComboBoxItem Content="Slow"/>
                                <ComboBoxItem Content="Linear 16"/>
                                <ComboBoxItem Content="Infinite"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Group 4: Target Curve & Coherence Blanking -->
                    <Border Grid.Column="3" Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,3">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Target:" Foreground="#64748B" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ComboBox x:Name="TargetCombo" Width="95" SelectedIndex="1">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="Harman"/>
                                <ComboBoxItem Content="B&amp;K 1974"/>
                                <ComboBoxItem Content="Cinema X"/>
                                <ComboBoxItem Content="Flat (0dB)"/>
                            </ComboBox>

                            <TextBlock Text="Blank:" Foreground="#64748B" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ComboBox x:Name="BlankingCombo" Width="68" SelectedIndex="1">
                                <ComboBoxItem Content="Off"/>
                                <ComboBoxItem Content="30%"/>
                                <ComboBoxItem Content="50%"/>
                                <ComboBoxItem Content="70%"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- TIER 2: PRO ACOUSTIC TOOLS, LIVE DELAY ALIGNMENT CAPSULE & ACTIONS -->
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    
                    <!-- Pro Tools Group (Min Phase, FDW, Delta Target, Invert Phase) -->
                    <Border Grid.Column="0" Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4,2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="MinPhaseBtn" Content="MIN &#216;" Classes="dock-pill" Foreground="#10B981" FontWeight="Bold"/>
                            <Button x:Name="FdwBtn" Content="FDW (10 cyc)" Classes="dock-pill" Foreground="#E040FB" FontWeight="Bold" ToolTip.Tip="Toggle Frequency-Dependent Windowing (Quasi-Anechoic)"/>
                            <Button x:Name="DeltaBtn" Content="&#916; TARGET" Classes="dock-pill-purple" ToolTip.Tip="Display Delta curve relative to Target"/>
                            <Button x:Name="InvertPolarityBtn" Content="INV &#216;" Classes="dock-pill" Foreground="#F59E0B" FontWeight="Bold" ToolTip.Tip="Invert Phase Polarity 180 deg"/>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== -->
                    <!-- PROMINENT DELAY & ACOUSTIC ALIGNMENT CAPSULE (FIXED) -->
                    <!-- ===================================================== -->
                    <Border Grid.Column="1" Background="{DynamicResource AppCardBg}" BorderBrush="#33FF9100" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                        <Grid ColumnDefinitions="Auto,Auto,85,Auto,54,1,Auto,66,120" VerticalAlignment="Center">
                            
                            <TextBlock Grid.Column="0" Text="DELAY:" Foreground="#FF9100" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            
                            <!-- Fine-tune Minus Button -->
                            <Button Grid.Column="1" x:Name="DelayMinusBtn" Content="&#8722;" Width="20" Height="20" Padding="0" CornerRadius="3"
                                    Background="#1E2638" Foreground="#FF9100" FontWeight="Bold" FontSize="11"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Decrement delay (-0.1 ms)" Margin="0,0,4,0"/>

                            <!-- Real-time Slider (fixed 85) -->
                            <Slider Grid.Column="2" x:Name="DelaySlider" Width="85" Minimum="0" Maximum="50" Value="4.2"
                                    Foreground="#FF9100" VerticalAlignment="Center"/>

                            <!-- Fine-tune Plus Button -->
                            <Button Grid.Column="3" x:Name="DelayPlusBtn" Content="+" Width="20" Height="20" Padding="0" CornerRadius="3"
                                    Background="#1E2638" Foreground="#FF9100" FontWeight="Bold" FontSize="11"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Increment delay (+0.1 ms)" Margin="4,0,6,0"/>

                            <!-- Readout in ms (fixed 54, right-aligned monospace) -->
                            <TextBlock Grid.Column="4" x:Name="DelayText" Text="4.2 ms" Foreground="#FF9100" FontWeight="Bold" FontSize="11" Width="54" TextAlignment="Right" VerticalAlignment="Center" FontFamily="JetBrains Mono, Consolas"/>

                            <!-- Separator -->
                            <Border Grid.Column="5" Width="1" Height="16" Background="#1E2638" Margin="6,0"/>

                            <!-- Detected Impulse Response Delay -->
                            <TextBlock Grid.Column="6" Text="IR:" Foreground="#64748B" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Grid.Column="7" x:Name="DetectedDelayText" Text="+4.18 ms" Foreground="#10B981" FontWeight="Bold" FontSize="11" Width="66" TextAlignment="Left" VerticalAlignment="Center" FontFamily="JetBrains Mono, Consolas" Margin="0,0,6,0"/>

                            <!-- Live Auto Align Button (fixed 120 width, centered, motionless position) -->
                            <Button Grid.Column="8" x:Name="AutoAlignBtn" Content="&#9889; ALIGN (+4.2 ms)" Width="120"
                                    Background="#26F59E0B" BorderBrush="#4DF59E0B" BorderThickness="1"
                                    Foreground="#F59E0B" FontWeight="Bold" FontSize="10" Padding="0,4"
                                    HorizontalContentAlignment="Center" CornerRadius="4" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Main Actions Group (Aligned Right) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="CaptureTraceBtn" Content="&#9679; CAPTURE [Space]"
                                Background="#00F0FF" Foreground="#000000" FontWeight="Bold" FontSize="10" Padding="12,5" CornerRadius="4" Cursor="Hand"/>
                        <Button x:Name="ClearTracesBtn" Content="CLEAR" Classes="dock-pill" FontSize="10" Padding="8,5"/>
                        <Button x:Name="ResetZoomBtn" Content="RESET (Z)" Classes="dock-pill" Foreground="#00F0FF" FontSize="10" Padding="8,5"/>
                        <Button x:Name="StartStopBtn" Content="PAUSE" Classes="dock-pill" Foreground="#F8FAFC" FontSize="10" Padding="8,5"/>
                    </StackPanel>

                </Grid>

            </StackPanel>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 2: MAIN 3-COLUMN WORKSPACE                                    -->
        <!-- Column 0: Left Trace Manager (260px)                              -->
        <!-- Column 1: Center Graph Canvas + HUD Capsule (*)                   -->
        <!-- Column 2: Right Inspector Drawer (300px)                          -->
        <Grid Grid.Row="2" x:Name="WorkspaceGrid" ColumnDefinitions="260,*,300">
            
            <!-- COLUMN 0: TRACE MANAGER SIDEBAR & COLLAPSED STRIP -->
            <Grid Grid.Column="0">
                <!-- Expanded Sidebar -->
                <Border x:Name="LeftSidebar" Background="{DynamicResource AppSidebarBg}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    
                    <!-- Sidebar Header -->
                    <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock x:Name="TracesCountText" Text="ACOUSTIC TRACES (5)" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            <Button x:Name="NewTraceBtn" Grid.Column="1" Content="+ NEW" Classes="dock-pill" Padding="6,2" FontSize="10" Margin="0,0,4,0"/>
                            <Button x:Name="CollapseLeftBtn" Grid.Column="2" Content="◀" Classes="dock-pill" Padding="6,2" FontSize="10" ToolTip.Tip="Collapse Traces Panel"/>
                        </Grid>
                    </Border>

                    <!-- Scrollable Trace Cards List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TraceListStack" Margin="10" Spacing="8">
                            
                            <!-- Card 1: Live Measurement -->
                            <Border Background="{DynamicResource AppCardSubBg}" BorderBrush="#00F0FF" BorderThickness="3,1,1,1" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Live Measurement" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#1A00F0FF" BorderBrush="#4D00F0FF" BorderThickness="1" CornerRadius="12" Padding="6,1">
                                            <TextBlock Text="LIVE" Foreground="#00F0FF" FontWeight="Bold" FontSize="8"/>
                                        </Border>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Delay: +4.18 ms" Foreground="#64748B" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                                        <TextBlock Grid.Column="1" Text="Coh: 94%" Foreground="#64748B" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Main L - Ground Plane -->
                            <Border Background="{DynamicResource AppCardSubBg}" BorderBrush="#A855F7" BorderThickness="3,1,1,1" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Main L - Ground Plane" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="&#9679; ON" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Delay: +3.82 ms" Foreground="#64748B" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                                        <TextBlock Grid.Column="1" Text="Captured" Foreground="#64748B" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Subwoofer Center -->
                            <Border Background="{DynamicResource AppCardSubBg}" BorderBrush="#10B981" BorderThickness="3,1,1,1" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Subwoofer Center" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="&#9679; ON" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Delay: +12.40 ms" Foreground="#64748B" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                                        <TextBlock Grid.Column="1" Text="Captured" Foreground="#64748B" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Balcony Delay Tower -->
                            <Border Background="{DynamicResource AppCardSubBg}" BorderBrush="#F59E0B" BorderThickness="3,1,1,1" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Balcony Delay Tower" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="&#9679; ON" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Delay: +28.15 ms" Foreground="#64748B" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                                        <TextBlock Grid.Column="1" Text="Offset: +24.3ms" Foreground="#64748B" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 5: Simulated Crossover Sum -->
                            <Border Background="{DynamicResource AppCardSubBg}" BorderBrush="#EC4899" BorderThickness="3,1,1,1" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Simulated Crossover Sum" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="&#8721; SUM" Foreground="#EC4899" FontSize="10" FontWeight="Bold"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Main + Sub aligned" Foreground="#64748B" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                                        <TextBlock Grid.Column="1" Text="&#916; = 0&#176; at 85Hz" Foreground="#64748B" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Bottom Quick Actions (AVG, SUM, DIFF, SAVE, LOAD) -->
                    <Border Grid.Row="2" Background="{DynamicResource AppSubPanelBg}" Padding="8,6" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <UniformGrid Columns="4">
                            <Button x:Name="SpatialAvgBtn" Content="AVG" Classes="dock-pill" FontSize="9" Padding="4,4" HorizontalContentAlignment="Center"/>
                            <Button x:Name="SimulateSumBtn" Content="SUM" Classes="dock-pill" FontSize="9" Padding="4,4" HorizontalContentAlignment="Center"/>
                            <Button x:Name="DiffTracesBtn" Content="DIFF" Classes="dock-pill" FontSize="9" Padding="4,4" HorizontalContentAlignment="Center"/>
                            <Button x:Name="BottomClearBtn" Content="CLEAR" Classes="dock-pill" FontSize="9" Padding="4,4" HorizontalContentAlignment="Center"/>
                        </UniformGrid>
                    </Border>

                </Grid>
            </Border>

            <!-- Collapsed Slim Strip (28px) -->
            <Border x:Name="LeftCollapsedStrip" Background="{DynamicResource AppSlimStripBg}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0"
                    IsVisible="False" Width="28" HorizontalAlignment="Stretch">
                <Grid RowDefinitions="Auto,*">
                    <Button x:Name="ExpandLeftBtn" Grid.Row="0" Content="▶" Classes="dock-pill"
                            Width="26" Height="26" Padding="0" Margin="1,6,1,0"
                            Foreground="#00F0FF" FontWeight="Bold" FontSize="10"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTip.Tip="Expand Acoustic Traces Panel"/>
                    <Button x:Name="ExpandLeftStripBtn" Grid.Row="1" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" Cursor="Hand"
                            ToolTip.Tip="Click to expand Acoustic Traces">
                        <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                            <LayoutTransformControl.LayoutTransform>
                                <RotateTransform Angle="-90"/>
                            </LayoutTransformControl.LayoutTransform>
                            <TextBlock Text="ACOUSTIC TRACES" Foreground="#94A3B8" FontWeight="Bold" FontSize="9"
                                       LetterSpacing="1"/>
                        </LayoutTransformControl>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- COLUMN 1: CENTER GRAPH VIEWPORT + FLOATING HUD & ZOOM -->
        <Grid Grid.Column="1" ClipToBounds="True" Background="{DynamicResource AppCanvasBg}">
            
            <!-- Main SkiaSharp Canvas -->
            <controls:AcousticGraphControl x:Name="GraphControl"/>

                <!-- Floating HUD Glass Capsule (Top Center - Rock Solid Fixed Width 590px) -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                        Width="590" Height="36"
                        Background="{DynamicResource AppHudBg}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="18"
                        BoxShadow="0 8 32 0 #80000000" IsHitTestVisible="False">
                    <Grid ColumnDefinitions="*,*,*,*,*" VerticalAlignment="Center" Margin="12,0">
                        
                        <!-- Col 0: FREQ -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="FREQ:" Foreground="#94A3B8" FontSize="11" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="HudFreqText" Text="1000.0 Hz" Foreground="#00F0FF" FontWeight="Bold" FontSize="11" FontFamily="JetBrains Mono, Consolas" Width="66" TextAlignment="Left" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Col 1: MAG -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="MAG:" Foreground="#94A3B8" FontSize="11" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="HudMagText" Text="+2.4 dB" Foreground="#00F0FF" FontWeight="Bold" FontSize="11" FontFamily="JetBrains Mono, Consolas" Width="56" TextAlignment="Left" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Col 2: PHASE -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="PHASE:" Foreground="#94A3B8" FontSize="11" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="HudPhaseText" Text="-45.2&#176;" Foreground="#FF9100" FontWeight="Bold" FontSize="11" FontFamily="JetBrains Mono, Consolas" Width="52" TextAlignment="Left" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Col 3: COH -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="COH:" Foreground="#94A3B8" FontSize="11" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="HudCohText" Text="98.2%" Foreground="#10B981" FontWeight="Bold" FontSize="11" FontFamily="JetBrains Mono, Consolas" Width="50" TextAlignment="Left" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Col 4: GD -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="GD:" Foreground="#94A3B8" FontSize="11" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="HudGdText" Text="0.12 ms" Foreground="#00F0FF" FontWeight="Bold" FontSize="11" FontFamily="JetBrains Mono, Consolas" Width="58" TextAlignment="Left" VerticalAlignment="Center"/>
                        </StackPanel>

                    </Grid>
                </Border>

                <!-- Floating Zoom Controls (Bottom Right) -->
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14">
                    <Button x:Name="ZoomInBtn" Content="+" Classes="zoom-btn" ToolTip.Tip="Zoom In"/>
                    <Button x:Name="ZoomOutBtn" Content="&#8722;" Classes="zoom-btn" ToolTip.Tip="Zoom Out"/>
                    <Button x:Name="GraphResetZoomBtn" Content="Z" Classes="zoom-btn" ToolTip.Tip="Reset Zoom (Z)"/>
                </StackPanel>

            </Grid>

            <!-- COLUMN 2: RIGHT DRAWER INSPECTOR & COLLAPSED STRIP -->
            <Grid Grid.Column="2">
                <!-- Expanded Sidebar -->
                <Border x:Name="RightSidebar" Background="{DynamicResource AppRightDrawerBg}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <!-- Inspector Header Bar with Collapse Button -->
                    <Border Grid.Row="0" Padding="12,6" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="ACOUSTIC INSPECTOR" Foreground="#64748B" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                            <Button x:Name="CollapseRightBtn" Grid.Column="1" Content="▶" Classes="dock-pill" Padding="6,2" FontSize="10" ToolTip.Tip="Collapse Inspector Panel"/>
                        </Grid>
                    </Border>
                    <TabControl Grid.Row="1" Background="Transparent">
                    
                    <!-- TAB 1: AUTO PEQ -->
                    <TabItem Header="AUTO PEQ">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16" Spacing="14">
                                
                                <!-- Auto PEQ Synthesizer Card -->
                                <Border Background="{DynamicResource AppCardInnerBg}" BorderBrush="{DynamicResource AppCardInnerBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Target: Harman Acoustic" Foreground="#F8FAFC" FontWeight="Bold" FontSize="10"/>
                                            <TextBlock Grid.Column="1" Text="RMS Err: 1.1 dB" Foreground="#00F0FF" FontWeight="Bold" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                                        </Grid>

                                        <!-- Filter Table Monospace -->
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <Border Background="#1A00F0FF" CornerRadius="4" Padding="4,1" Margin="0,0,8,0">
                                                    <TextBlock Text="PK 1" Foreground="#00F0FF" FontWeight="Bold" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="62.5 Hz" Foreground="#CBD5E1" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                                <TextBlock Grid.Column="2" Text="-4.2 dB" Foreground="#EF4444" FontWeight="Bold" FontSize="11" Margin="0,0,8,0" FontFamily="JetBrains Mono, Consolas"/>
                                                <TextBlock Grid.Column="3" Text="Q: 3.4" Foreground="#94A3B8" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <Border Background="#1A00F0FF" CornerRadius="4" Padding="4,1" Margin="0,0,8,0">
                                                    <TextBlock Text="PK 2" Foreground="#00F0FF" FontWeight="Bold" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="145.0 Hz" Foreground="#CBD5E1" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                                <TextBlock Grid.Column="2" Text="+2.8 dB" Foreground="#10B981" FontWeight="Bold" FontSize="11" Margin="0,0,8,0" FontFamily="JetBrains Mono, Consolas"/>
                                                <TextBlock Grid.Column="3" Text="Q: 2.1" Foreground="#94A3B8" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <Border Background="#1A00F0FF" CornerRadius="4" Padding="4,1" Margin="0,0,8,0">
                                                    <TextBlock Text="PK 3" Foreground="#00F0FF" FontWeight="Bold" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="520.0 Hz" Foreground="#CBD5E1" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                                <TextBlock Grid.Column="2" Text="-3.1 dB" Foreground="#EF4444" FontWeight="Bold" FontSize="11" Margin="0,0,8,0" FontFamily="JetBrains Mono, Consolas"/>
                                                <TextBlock Grid.Column="3" Text="Q: 4.8" Foreground="#94A3B8" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <Border Background="#1A00F0FF" CornerRadius="4" Padding="4,1" Margin="0,0,8,0">
                                                    <TextBlock Text="PK 4" Foreground="#00F0FF" FontWeight="Bold" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="2840.0 Hz" Foreground="#CBD5E1" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                                <TextBlock Grid.Column="2" Text="-1.9 dB" Foreground="#EF4444" FontWeight="Bold" FontSize="11" Margin="0,0,8,0" FontFamily="JetBrains Mono, Consolas"/>
                                                <TextBlock Grid.Column="3" Text="Q: 1.8" Foreground="#94A3B8" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                            </Grid>
                                        </StackPanel>

                                        <Button x:Name="ExportBiquadsBtn" Content="EXPORT MINIDSP BIQUADS"
                                                Background="#00F0FF" Foreground="#000000" FontWeight="Bold" FontSize="11"
                                                CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Padding="0,8" Margin="0,6,0,0" Cursor="Hand"/>
                                    </StackPanel>
                                </Border>

                                <!-- Electroacoustic Purity Card -->
                                <Border Background="{DynamicResource AppCardInnerBg}" BorderBrush="{DynamicResource AppCardInnerBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Electroacoustic Purity" Foreground="#00F0FF" FontWeight="Bold" FontSize="10"/>
                                            <TextBlock Grid.Column="1" Text="THD: 0.14%" Foreground="#10B981" FontWeight="Bold" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                                        </Grid>

                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="2nd Harmonic (H2):" Foreground="#94A3B8" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                                <TextBlock Grid.Column="1" Text="-62.4 dBc" Foreground="#CBD5E1" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="3rd Harmonic (H3):" Foreground="#94A3B8" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                                <TextBlock Grid.Column="1" Text="-68.1 dBc" Foreground="#CBD5E1" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="SMPTE IMD (60+7k):" Foreground="#94A3B8" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                                <TextBlock Grid.Column="1" Text="0.22%" Foreground="#10B981" FontWeight="Bold" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Thermal Compression:" Foreground="#94A3B8" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                                <TextBlock Grid.Column="1" Text="-0.3 dB" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Reports & Export Section -->
                                <Border Background="{DynamicResource AppCardInnerBg}" BorderBrush="{DynamicResource AppCardInnerBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="REPORTS &amp; EXPORT" Foreground="#64748B" FontWeight="Bold" FontSize="10"/>
                                        <Grid ColumnDefinitions="*,8,*">
                                            <Button x:Name="ExportReportBtn" Content="EXPORT REPORT..." Classes="dock-pill"
                                                    Background="#1A00F0FF" BorderBrush="#4D00F0FF" BorderThickness="1"
                                                    Foreground="#00F0FF" FontWeight="Bold"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,8"
                                                    ToolTip.Tip="Export session report to PDF, HTML, or Text"/>
                                            <Button x:Name="CsvReportBtn" Grid.Column="2" Content="CSV TRACE" Classes="dock-pill"
                                                    Background="#0DFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,8"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 2: DELAY MATRIX -->
                    <TabItem Header="DELAY MATRIX">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16" Spacing="14">
                                
                                <!-- Crossover Phase Alignment -->
                                <Border Background="{DynamicResource AppCardInnerBg}" BorderBrush="{DynamicResource AppCardInnerBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="CROSSOVER ALIGNMENT" Foreground="#00F0FF" FontWeight="Bold" FontSize="10"/>
                                            <Button x:Name="CalculateAlignmentBtn" Grid.Column="1" Content="CALC" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="9" Padding="8,3" CornerRadius="4"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Fc:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CrossoverFreqCombo" Width="100" SelectedIndex="1" FontSize="11">
                                                <ComboBoxItem Content="60 Hz"/>
                                                <ComboBoxItem Content="80 Hz"/>
                                                <ComboBoxItem Content="100 Hz"/>
                                                <ComboBoxItem Content="120 Hz"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <TextBlock x:Name="AlignmentResultText" Text="Capture &gt;= 2 traces (Sub, Main) to analyze acoustic phase crossover" Foreground="#64748B" FontSize="10" TextWrapping="Wrap"/>
                                        <Button x:Name="ApplyAlignmentBtn" Content="APPLY TO TRACE" Background="#2E7D32" Foreground="White" FontWeight="Bold" FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,6" IsVisible="False"/>
                                    </StackPanel>
                                </Border>

                                <!-- Multi-Zone Delay Matrix -->
                                <Border Background="{DynamicResource AppCardInnerBg}" BorderBrush="{DynamicResource AppCardInnerBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="MULTI-ZONE MATRIX (20&#176;C)" Foreground="#F59E0B" FontWeight="Bold" FontSize="10"/>
                                            <Button x:Name="CalculateDelayMatrixBtn" Grid.Column="1" Content="CALC" Background="#E65100" Foreground="White" FontWeight="Bold" FontSize="9" Padding="8,3" CornerRadius="4"/>
                                        </Grid>
                                        <TextBlock x:Name="DelayMatrixResultText" Text="Anchor: Main L (c=343 m/s)&#x0a;- Sub Center: +8.58 ms (+2.94 m)&#x0a;- Delay Tower: +24.33 ms (+8.35 m)" Foreground="#FFB300" FontSize="10" FontFamily="JetBrains Mono, Consolas" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 3: DISTORTION -->
                    <TabItem Header="DISTORTION">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16" Spacing="14">
                                
                                <Border Background="{DynamicResource AppCardInnerBg}" BorderBrush="{DynamicResource AppCardInnerBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="ROOM ACOUSTICS (ISO 3382)" Foreground="#A855F7" FontWeight="Bold" FontSize="10"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="RT60 (T30):" Foreground="#94A3B8" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                            <TextBlock Text="0.48 s" Foreground="#A855F7" FontWeight="Bold" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="STI Intelligibility:" Foreground="#94A3B8" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                            <TextBlock Text="0.81 (Excellent)" Foreground="#10B981" FontWeight="Bold" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource AppCardInnerBg}" BorderBrush="{DynamicResource AppCardInnerBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="FEEDBACK HUNTER" Foreground="#EF4444" FontWeight="Bold" FontSize="10"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Live Feedback Peaks:" Foreground="#94A3B8" FontSize="11"/>
                                            <TextBlock Text="None Detected" Foreground="#10B981" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
                </Grid>
            </Border>

            <!-- Collapsed Slim Strip (28px) -->
            <Border x:Name="RightCollapsedStrip" Background="{DynamicResource AppSlimStripBg}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0"
                    IsVisible="False" Width="28" HorizontalAlignment="Stretch">
                <Grid RowDefinitions="Auto,*">
                    <Button x:Name="ExpandRightBtn" Grid.Row="0" Content="◀" Classes="dock-pill"
                            Width="26" Height="26" Padding="0" Margin="1,6,1,0"
                            Foreground="#00F0FF" FontWeight="Bold" FontSize="10"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTip.Tip="Expand Inspector Panel"/>
                    <Button x:Name="ExpandRightStripBtn" Grid.Row="1" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" Cursor="Hand"
                            ToolTip.Tip="Click to expand Inspector">
                        <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                            <LayoutTransformControl.LayoutTransform>
                                <RotateTransform Angle="90"/>
                            </LayoutTransformControl.LayoutTransform>
                            <TextBlock Text="ACOUSTIC INSPECTOR" Foreground="#94A3B8" FontWeight="Bold" FontSize="9"
                                       LetterSpacing="1"/>
                        </LayoutTransformControl>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        </Grid>

        <!-- ================================================================= -->
        <!-- ROW 3: TELEMETRY STATUS FOOTER                                    -->
        <!-- ================================================================= -->
        <Border Grid.Row="3" Background="{DynamicResource AppFooterBg}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                <!-- Left Telemetry Metrics -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="BUFFER: LOCK-FREE FIFO 0.8ms" Foreground="#64748B" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                    <TextBlock Text="IFFT DELAY: +4.18 ms (1.43 m)" Foreground="#10B981" FontWeight="Bold" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                    <TextBlock Text="RT60: T30 = 0.48 s" Foreground="#A855F7" FontWeight="Bold" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                    <TextBlock Text="STI: 0.81 (Excellent)" Foreground="#00F0FF" FontWeight="Bold" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                </StackPanel>

                <!-- Center Shortcuts -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="[Space] Capture | [A] Align | [Z] Zoom | [M] Mode | [T] Theme | [ / ] Panels" Foreground="#64748B" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                </StackPanel>

                <!-- Right Brand Signature -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="SoundCalibrator Core .NET 10 | Uncle Bob Clean Architecture" Foreground="#475569" FontSize="10" FontFamily="JetBrains Mono, Consolas"/>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>

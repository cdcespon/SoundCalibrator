<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundCalibrator.App.Controls"
        x:Class="SoundCalibrator.App.MainWindow"
        Title="SoundCalibrator - Dual-Channel FFT Acoustic Measurement (Open Sound Meter Clone)"
        Width="1280" Height="760"
        Background="#0B0E14"
        FontFamily="Segoe UI">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Background="#141821" BorderBrush="#222836" BorderThickness="0,0,0,1" Padding="12,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- LOGO / TITULO -->
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                    <TextBlock Text="SOUND" Foreground="#00E5FF" FontWeight="Bold" FontSize="16" Margin="0,0,4,0"/>
                    <TextBlock Text="CALIBRATOR" Foreground="#E0E6ED" FontWeight="SemiBold" FontSize="16"/>
                </StackPanel>

                <!-- FUENTE DE AUDIO -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Source:" Foreground="#7E8B9B" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                    <ComboBox x:Name="SourceCombo" Width="170" SelectedIndex="0">
                        <ComboBoxItem Content="Pink Noise (Synthetic)"/>
                        <ComboBoxItem Content="Sine 1kHz (Synthetic)"/>
                        <ComboBoxItem Content="WASAPI Audio Device"/>
                    </ComboBox>
                </StackPanel>

                <!-- PROMEDIO -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Averaging:" Foreground="#7E8B9B" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                    <ComboBox x:Name="AveragingCombo" Width="130" SelectedIndex="1">
                        <ComboBoxItem Content="None"/>
                        <ComboBoxItem Content="Fast (Exp)"/>
                        <ComboBoxItem Content="Slow (Exp)"/>
                        <ComboBoxItem Content="Linear 16"/>
                        <ComboBoxItem Content="Infinite"/>
                    </ComboBox>
                </StackPanel>

                <!-- SUAVIZADO DE OCTAVA -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Smooth:" Foreground="#7E8B9B" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                    <ComboBox x:Name="SmoothingCombo" Width="110" SelectedIndex="0">
                        <ComboBoxItem Content="None"/>
                        <ComboBoxItem Content="1/3 Oct"/>
                        <ComboBoxItem Content="1/6 Oct"/>
                        <ComboBoxItem Content="1/12 Oct"/>
                        <ComboBoxItem Content="1/24 Oct"/>
                    </ComboBox>
                </StackPanel>

                <!-- DELAY SLIDER (PARA SIMULACIÓN ACÚSTICA) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Delay:" Foreground="#7E8B9B" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                    <Slider x:Name="DelaySlider" Width="90" Minimum="0" Maximum="20" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="False"/>
                    <TextBlock x:Name="DelayText" Text="0.0 ms" Foreground="#FF9100" VerticalAlignment="Center" Width="45" Margin="4,0,0,0" FontSize="11"/>
                </StackPanel>

                <!-- GAIN SLIDER -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Gain:" Foreground="#7E8B9B" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                    <Slider x:Name="GainSlider" Width="80" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" IsSnapToTickEnabled="False"/>
                    <TextBlock x:Name="GainText" Text="0 dB" Foreground="#00E5FF" VerticalAlignment="Center" Width="40" Margin="4,0,0,0" FontSize="11"/>
                </StackPanel>

                <!-- BOTONES DE ACCION -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="StartStopBtn" Content="PAUSE" Background="#1E88E5" Foreground="White" FontWeight="Bold" Width="70" Margin="0,0,8,0"/>
                    <Button x:Name="ResetBtn" Content="RESET" Background="#263238" Foreground="#E0E6ED" Width="65"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- AREA CENTRAL: GRAFICO ACUSTICO -->
        <controls:AcousticGraphControl x:Name="GraphControl" Grid.Row="1"/>

        <!-- BARRA DE ESTADO INFERIOR -->
        <Border Grid.Row="2" Background="#0E1117" BorderBrush="#1C222E" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="LEGEND:" Foreground="#506070" FontSize="11" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Border Background="#00E5FF" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Magnitude (dB)" Foreground="#00E5FF" FontSize="11" Margin="0,0,14,0"/>

                    <Border Background="#FF9100" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Phase (°)" Foreground="#FF9100" FontSize="11" Margin="0,0,14,0"/>

                    <Border Background="#00E676" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Coherence" Foreground="#00E676" FontSize="11" Margin="0,0,14,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock x:Name="StatusDeviceText" Text="Synthetic Generator (48 kHz, FFT: 1024)" Foreground="#8C9BAE" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock x:Name="StatusAvgText" Text="Averages: 0" Foreground="#00E676" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock Text="GPU: SkiaSharp Accelerated (60 FPS)" Foreground="#00E5FF" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
